{
  "datasets": [
    {
      "name": "team_season",
      "displayName": "team_season",
      "queryLines": [
        "SELECT\n",
        "  season, team, games, wins, losses, ties,\n",
        "  CONCAT(wins, '-', losses, IF(ties > 0, CONCAT('-', ties), '')) AS record,\n",
        "  CONCAT(ats_covers, '-', ats_losses) AS ats_record,\n",
        "  ROUND(off_epa_per_play, 3)  AS offense_epa,\n",
        "  ROUND(-def_epa_per_play, 3) AS defense_epa,   -- sign flipped: higher = better defense\n",
        "  ROUND(net_epa_per_play, 3)  AS net_epa,\n",
        "  net_epa_rank,\n",
        "  RANK() OVER (PARTITION BY season ORDER BY (wins + 0.5 * ties) / games DESC) AS record_rank,\n",
        "  net_epa_rank - RANK() OVER (PARTITION BY season ORDER BY (wins + 0.5 * ties) / games DESC) AS luck_gap\n",
        "FROM workspace.nfl.gold_team_season\n",
        "ORDER BY season DESC, luck_gap\n"
      ]
    },
    {
      "name": "qb_leaders",
      "displayName": "qb_leaders",
      "queryLines": [
        "SELECT season, epa_rank, player_name, latest_team, dropbacks,\n",
        "       ROUND(epa_per_dropback, 3) AS epa_per_dropback, ROUND(cpoe, 1) AS cpoe\n",
        "FROM workspace.nfl.gold_qb_season\n",
        "WHERE epa_rank <= 15\n"
      ]
    },
    {
      "name": "team_games",
      "displayName": "team_games",
      "queryLines": [
        "SELECT season, week, game_date, team, opponent, home_away, outcome,\n",
        "       CONCAT(points_for, '-', points_against) AS score,\n",
        "       ROUND(net_epa_per_play, 3) AS net_epa, cover_margin, ats_outcome\n",
        "FROM workspace.nfl.gold_team_games\n",
        "WHERE game_type = 'REG'\n"
      ]
    }
  ],
